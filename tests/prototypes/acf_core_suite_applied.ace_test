# ACF-shaped ACE core validation prototype.
# Focus: activation, acceptance/refusal, classification, legality, delegation, and cleanup.
# These names map to verified ACE entry points; fixture ids are resolved by the registry.
# Suite scope: ace.native.core core-function validation

new Test "A valid prop is accepted and classified"
scenario ace.native.core.valid_prop
requires native
uses valid_prop as Prop
do ACE.Check on Prop as EntityType
expect EntityType is "Prop"
expect Prop.ACE exists
cleanup automatic

new Test "Damage dispatches each public damage hook once"
scenario ace.native.damage.hook_dispatch_once
requires native
uses damage_hook_target as Target
do ACE.DamageHookContract on Target as Hooks
expect Hooks.canonical is 1
expect Hooks.legacy is 1
cleanup automatic

new Test "Reported gameplay surfaces remain usable"
scenario ace.native.gameplay.surface_contract
requires native
uses valid_prop as Owner
do ACE.GameplayContract on Owner as Gameplay
expect Gameplay.armor_health is true
expect Gameplay.engine_operation is true
expect Gameplay.rack_link_persistence is true
expect Gameplay.missile_reload is true
expect Gameplay.chat_surface is true
expect Gameplay.weapons_plus_compat is true
expect Gameplay.camera_surface is true
expect Gameplay.points_force_dispatch is true
cleanup automatic

new Test "The reusable fixture exercises the full mounted ACE surface"
scenario ace.native.full_mod.fixture
requires native
uses valid_prop as Owner
do ACE.FullModFixture on Owner as FullMod
expect FullMod.ok is true
cleanup automatic

new Test "An invalid entity is refused without activation"
scenario ace.native.core.invalid_entity
requires native
uses invalid_prop as Prop
do ACE.Check on Prop as Result
expect Result is false
expect Prop.ACE does not exist
cleanup automatic

new Test "An entity with invalid physics is refused"
scenario ace.native.core.invalid_physics
requires native
uses prop_without_physics as Prop
do ACE.Check on Prop as Result
expect Result is false
cleanup automatic

new Test "Ignored and exploding entities are refused"
scenario ace.native.core.refusal_guards
requires native
uses ignored_prop as IgnoredProp
uses exploding_prop as ExplodingProp
do ACE.Check on IgnoredProp as IgnoredResult
do ACE.Check on ExplodingProp as ExplodingResult
expect IgnoredResult is false
expect ExplodingResult is false
cleanup automatic

new Test "A stale prop is reactivated before it is accepted"
scenario ace.native.core.stale_reactivation
requires native
uses stale_prop as Prop
do ACE.Check on Prop as EntityType
expect EntityType is "Prop"
expect Prop was reactivated
cleanup automatic

new Test "A player is classified as squishy"
scenario ace.native.core.player_classification
requires native
uses test_player as Entity
do ACE.Check on Entity as EntityType
expect EntityType is "Squishy"
cleanup automatic

new Test "A vehicle is classified as a vehicle"
scenario ace.native.core.vehicle_classification
requires native
uses test_vehicle as Entity
do ACE.Check on Entity as EntityType
expect EntityType is "Vehicle"
cleanup automatic

new Test "A valid prop passes legality"
scenario ace.native.core.legal_prop
requires native
uses legal_prop as Prop
do ACE.CheckLegal on Prop as LegalResult
expect LegalResult is legal
cleanup automatic

new Test "A non-solid prop fails legality with a useful reason"
scenario ace.native.core.non_solid_legality
requires native
uses non_solid_prop as Prop
do ACE.CheckLegal on Prop as LegalResult
expect LegalResult is not legal
expect LegalResult reason is "Not solid"
cleanup automatic

new Test "A prop with visual clipping fails legality"
scenario ace.native.core.visual_clip_legality
requires native
uses clipped_prop as Prop
do ACE.CheckLegal on Prop as LegalResult
expect LegalResult is not legal
expect LegalResult reason is "Has visclip"
cleanup automatic

new Test "A prop with missing ACE state is activated by checking"
scenario ace.native.core.check_activation
requires native
uses uninitialized_prop as Prop
do ACE.Check on Prop as EntityType
expect EntityType is "Prop"
expect Prop was activated
cleanup automatic

new Test "Cleanup removes native test state"
scenario ace.native.core.activation_state
requires native
uses uninitialized_prop as Prop
do ACE.Activate on Prop as Activation
expect Prop.ACE exists
expect Prop.ACE has armor and health
cleanup automatic

new Test "Armor gate handles boundaries and specialized materials"
scenario ace.native.armor.gate_boundaries
requires native
uses gate_target_below as BelowTarget
uses gate_target_above as AboveTarget
uses gate_target_zero as ZeroTarget
uses gate_target_non_kinetic as NonKineticTarget
uses gate_target_era_numeric as EraTarget
uses gate_energy_below as BelowEnergy
uses gate_energy_above as AboveEnergy
uses gate_energy_low as LowEnergy
uses gate_area as Area
uses gate_angle as Angle
uses gate_ap_type as AP
uses gate_he_type as HE
do ACE.CalcDamage on BelowTarget and BelowEnergy and Area and Angle and AP as BelowResult
do ACE.CalcDamage on AboveTarget and AboveEnergy and Area and Angle and AP as AboveResult
do ACE.CalcDamage on ZeroTarget and LowEnergy and Area and Angle and AP as ZeroResult
do ACE.CalcDamage on NonKineticTarget and LowEnergy and Area and Angle and HE as NonKineticResult
do ACE.CalcDamage on EraTarget and BelowEnergy and Area and Angle and AP as EraResult
expect BelowResult.Damage is 0
expect BelowResult.KineticThresholdFailed is true
expect AboveResult.Damage is greater than 0
expect AboveResult.KineticThresholdFailed does not exist
expect ZeroResult.KineticThresholdFailed does not exist
expect NonKineticResult.KineticThresholdFailed does not exist
expect EraResult.KineticThresholdFailed does not exist
cleanup automatic

new Test "Armor gate classifies rounds and protects prop mutation"
scenario ace.native.armor.gate_classification_and_mutation
requires native
uses type_ap as AP
uses type_apds as APDS
uses type_apfsds as APFSDS
uses type_aphe as APHE
uses type_cap as CAP
uses type_fl as FL
uses type_hp as HP
uses type_hvap as HVAP
uses type_he as HE
uses type_heat as HEAT
uses type_hesh as HESH
uses type_spall as Spall
uses gate_prop_target as Target
uses gate_energy_below as Energy
uses gate_area as Area
uses gate_angle as Angle
do ACE.IsKineticDamageType on AP as APResult
do ACE.IsKineticDamageType on APDS as APDSResult
do ACE.IsKineticDamageType on APFSDS as APFSDSResult
do ACE.IsKineticDamageType on APHE as APHEResult
do ACE.IsKineticDamageType on CAP as CAPResult
do ACE.IsKineticDamageType on FL as FLResult
do ACE.IsKineticDamageType on HP as HPResult
do ACE.IsKineticDamageType on HVAP as HVAPResult
do ACE.IsKineticDamageType on HE as HEResult
do ACE.IsKineticDamageType on HEAT as HEATResult
do ACE.IsKineticDamageType on HESH as HESHResult
do ACE.IsKineticDamageType on Spall as SpallResult
do ACE.PropDamage on Target and Energy and Area and Angle and Target and Target and AP as DamageResult
expect APResult is true
expect APDSResult is true
expect APFSDSResult is true
expect APHEResult is true
expect CAPResult is true
expect FLResult is true
expect HPResult is true
expect HVAPResult is true
expect HEResult is false
expect HEATResult is false
expect HESHResult is false
expect SpallResult is false
expect DamageResult.Damage is 0
expect DamageResult.KineticThresholdFailed is true
expect Target.ACE.Health is 100
expect Target.ACE.Armour is 100
cleanup automatic

new Test "Armor health preserves reference and modifier behavior"
scenario ace.native.armor.health_contracts
requires native
uses health_reference_area as Area
uses health_quarter_area as QuarterArea
uses health_zero as ZeroArea
uses health_ductility as Ductility
uses health_high_ductility as HighDuctility
uses health_reference_armour as Armour
uses health_thirty_armour as ThickArmour
uses health_half_armour as HalfArmour
uses health_quarter_armour as QuarterArmour
do ACE.CalcHealth on Area and Ductility and Armour as ReferenceHealth
do ACE.CalcHealth on Area and HighDuctility and Armour as DuctileHealth
do ACE.CalcHealth on Area and Ductility and ThickArmour as ThickHealth
do ACE.CalcHealth on Area and Ductility and HalfArmour as HalfHealth
do ACE.CalcHealth on ZeroArea and Ductility and Armour as ZeroHealth
do ACE.CalcHealth on QuarterArea and Ductility and QuarterArmour as QuarterHealth
expect ReferenceHealth is 1
expect DuctileHealth is 1.8
expect ThickHealth is 1
expect HalfHealth is 1
expect ZeroHealth is 0
expect QuarterHealth is 0.25
cleanup automatic
